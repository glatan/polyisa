# polyisa x32 toolchain environment
#
# Builds x32 (x86-64 ILP32) test binaries for heavy_program_x32.
# Toolchain and license are registered in docs/references.md (TOOL-GCC-X32).
#
# Usage:
#   podman build -t localhost/polyisa-x32:14.2.0 tools/containers/x32
#   podman run --rm -v ./work:/work localhost/polyisa-x32:14.2.0 \
#     x86_64-linux-gnux32-gcc-14 -O2 -static -o /work/prog /work/prog.c
#
# Binaries run on hosts whose kernel has CONFIG_X86_X32_ABI=y.

FROM docker.io/library/debian:trixie@sha256:bfc36aecdece0387418759dba474aa856c026ca8087da3606b41b90ab0509c99

ARG DEBIAN_FRONTEND=noninteractive

# gcc-14-x86-64-linux-gnux32 14.2.0-19cross1, libc6-dev-x32-cross 2.41-11cross1
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-x86-64-linux-gnux32 \
    libc6-dev-x32-cross \
    binutils-x86-64-linux-gnux32 \
    && rm -rf /var/lib/apt/lists/*

RUN x86_64-linux-gnux32-gcc-14 --version && x86_64-linux-gnux32-readelf --version

WORKDIR /work
CMD ["/bin/bash"]
